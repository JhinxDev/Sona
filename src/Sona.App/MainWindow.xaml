<Window x:Class="Sona.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sona.App" Style="{StaticResource {x:Type Window}}" Title="Sona" Icon="/Sona;component/Assets/Sona.ico" Width="1000" Height="700" MinWidth="740" MinHeight="530" WindowStartupLocation="CenterScreen" ShowActivated="False">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TabControl x:Name="Pages" AutomationProperties.Name="Sona pages">
  <TabItem Header="Home" Tag="&#xE80F;" AutomationProperties.Name="Home" AutomationProperties.AutomationId="DictationTab">
   <ScrollViewer x:Name="HomeScroll" Padding="32,26" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="{Binding ViewportHeight, ElementName=HomeScroll}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="ProfileWarning" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,0,0,12"/><Button x:Name="UpdateNotice" Content="A Sona update is available. View details" Click="UpdateNotice_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Home" Style="{StaticResource PageTitle}"/><TextBlock Text="Dictate into the app you're using, or review your text here." Style="{StaticResource Description}"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SettingGroup}" Padding="18" Margin="0,22,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="Status" Text="Ready to dictate" FontWeight="SemiBold" FontSize="15" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusDetail" Text="Hold Ctrl + Windows while you speak. Release to finish." Style="{StaticResource Description}"/></StackPanel><Button x:Name="RecordButton" Grid.Column="1" Content="Record" Click="Record_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="86" AutomationProperties.Name="Start or stop intentional recording"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,10"><TextBlock Text="Latest draft" FontWeight="SemiBold"/><TextBlock x:Name="DraftStage" Text="Editable" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
     <Grid Grid.Row="1" MinHeight="150"><TextBox x:Name="Draft" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="14" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" TextChanged="Draft_Changed" AutomationProperties.Name="Editable cleaned draft"/><TextBlock Text="Your dictation will appear here." Foreground="{DynamicResource Muted}" Margin="15" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Grid Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="CopyButton" Content="Copy draft" IsEnabled="False" Click="Copy_Click"/><Button x:Name="OriginalButton" Content="Use original" Click="Original_Click" Margin="8,0,0,0"/></StackPanel><Button x:Name="ClearDraftButton" Content="Clear draft" Click="Clear_Click" HorizontalAlignment="Right" Margin="16,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Setter Property="BorderBrush" Value="{DynamicResource Danger}"/></Trigger></Style.Triggers></Style></Button.Style></Button></Grid>
     <StackPanel Grid.Row="3"><Expander Header="Original transcript" Margin="0,15,0,0"><TextBox x:Name="Original" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="105" MinHeight="50" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="Original transcript"/></Expander>
     <WrapPanel Margin="0,12,0,0"><Button Content="Save draft" Click="SaveDraft_Click" Margin="0,0,8,8"/><Button Content="Review corrections" Click="ReviewCorrections_Click" Margin="0,0,8,8"/><Button Content="Export for review" Click="ExportDraft_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="DraftReviewResult" Style="{StaticResource Description}" Text="Save individual drafts locally, or review a spelling edit to teach future dictation. Nothing is uploaded."/><ItemsControl x:Name="CorrectionSuggestions" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Inset}" Padding="12" CornerRadius="8"><StackPanel><TextBlock Text="Use this spelling in future dictation?" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><TextBlock Text="{Binding Spoken}" VerticalAlignment="Center"/><TextBlock Text=" → " VerticalAlignment="Center"/><TextBlock Text="{Binding Written}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Learn correction" Tag="{Binding}" Click="LearnCorrection_Click" Margin="12,0,0,0"/></WrapPanel><TextBlock Text="Applies to future dictation outside Verbatim. Manage the rule in Vocabulary." Style="{StaticResource Description}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander x:Name="CleanedReview" Header="Cleaned suggestion · your edits are kept above" Visibility="Collapsed" Margin="0,10,0,0"><StackPanel><TextBox x:Name="CleanedSuggestion" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Final cleaned suggestion"/><Button Content="Use cleaned suggestion" Click="UseCleaned_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel>
    </Grid><TextBlock Grid.Row="3" Text="Esc cancels. Enter sends only when you enable it and use it to finish hands-free recording." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,16,0,12"/>
   </Grid></ScrollViewer>
  </TabItem>
  <TabItem Header="Settings" Tag="&#xE713;" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsTab">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.Resources><Style x:Key="SettingsCategory" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="CategoryBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Inset}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="CategoryBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Panel}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CategoryBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources>
    <StackPanel Margin="32,26,24,10"><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/><WrapPanel Margin="0,18,0,0" AutomationProperties.Name="Settings sections"><RadioButton x:Name="SettingsGeneralNav" Content="General" Tag="General" GroupName="SettingsSection" Style="{StaticResource SettingsCategory}" Checked="SettingsSection_Checked" AutomationProperties.AutomationId="SettingsGeneralNav" IsChecked="True"/>
<RadioButton x:Name="SettingsAudioNav" Content="Audio &amp; typing" Tag="Audio" GroupName="SettingsSection" Style="{StaticResource SettingsCategory}" Checked="SettingsSection_Checked" AutomationProperties.AutomationId="SettingsAudioNav"/>
<RadioButton x:Name="SettingsAppearanceNav" Content="Appearance" Tag="Appearance" GroupName="SettingsSection" Style="{StaticResource SettingsCategory}" Checked="SettingsSection_Checked" AutomationProperties.AutomationId="SettingsAppearanceNav"/>
<RadioButton x:Name="SettingsCleanupNav" Content="Text cleanup" Tag="Cleanup" GroupName="SettingsSection" Style="{StaticResource SettingsCategory}" Checked="SettingsSection_Checked" AutomationProperties.AutomationId="SettingsCleanupNav"/>
<RadioButton x:Name="SettingsPrivacyNav" Content="Privacy" Tag="Privacy" GroupName="SettingsSection" Style="{StaticResource SettingsCategory}" Checked="SettingsSection_Checked" AutomationProperties.AutomationId="SettingsPrivacyNav"/>
<RadioButton x:Name="SettingsDiscordNav" Content="Discord" Tag="Discord" GroupName="SettingsSection" Style="{StaticResource SettingsCategory}" Checked="SettingsSection_Checked" AutomationProperties.AutomationId="SettingsDiscordNav"/>
<RadioButton x:Name="SettingsAboutNav" Content="About" Tag="About" GroupName="SettingsSection" Style="{StaticResource SettingsCategory}" Checked="SettingsSection_Checked" AutomationProperties.AutomationId="SettingsAboutNav"/></WrapPanel></StackPanel>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Margin="0,0,0,12" Padding="32,0,32,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock x:Name="SettingsSectionTitle" Text="General" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,4"/>
     <TextBlock x:Name="SettingsSectionDescription" Text="Make Sona fit your day." Style="{StaticResource Description}" Margin="0,0,0,16"/>
<StackPanel x:Name="SettingsGeneralSection" Visibility="Visible"><Border Style="{StaticResource SettingGroup}"><StackPanel>
<Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,0,0,14"><CheckBox x:Name="SoundEffects" Content="Sound effects" FontWeight="SemiBold" AutomationProperties.AutomationId="SoundEffects"/><TextBlock Text="Subtle cues when Sona opens, recording begins, your draft is ready, and Enter is sent." Style="{StaticResource Description}"/></StackPanel></Border>
<Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CloseToTray" Content="Keep Sona in the tray when I close the window" FontWeight="SemiBold"/></Border>
<Border Style="{StaticResource SettingRow}" BorderThickness="0"><StackPanel><CheckBox x:Name="StartWithWindows" Content="Launch at startup" FontWeight="SemiBold"/><TextBlock x:Name="StartupReason" Visibility="Collapsed" Style="{StaticResource Description}" Margin="0,0,0,10"/></StackPanel></Border>
</StackPanel></Border></StackPanel>
<StackPanel x:Name="SettingsAudioSection" Visibility="Collapsed"><Border Style="{StaticResource SettingGroup}"><StackPanel>
<Border Style="{StaticResource SettingRow}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Speech language" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="SpeechLanguage" AutomationProperties.Name="Speech language" Margin="0,7"><ComboBoxItem Content="English + French (auto)" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Fran&#xE7;ais" Tag="fr"/></ComboBox></Grid></Border>
<Border Style="{StaticResource SettingRow}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Column="1" x:Name="MicrophoneLabel" Text="Microphone" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="Device" AutomationProperties.Name="Microphone" Margin="0,7"/><Button Grid.Row="1" Grid.Column="2" Content="Refresh microphones" Click="Refresh_Click" HorizontalAlignment="Right" Margin="0,0,0,8"/></Grid></Border>
<Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,12"><TextBlock Text="Recording shortcut" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><ComboBox x:Name="ShortcutMode" Width="180" MinHeight="36" AutomationProperties.Name="Recording shortcut mode" Margin="0,0,12,0"><ComboBoxItem Content="Hold / double-tap"/><ComboBoxItem Content="Toggle"/></ComboBox><Border Background="{DynamicResource Canvas}" CornerRadius="6" Padding="10,7" VerticalAlignment="Center"><TextBlock Text="Ctrl + Win" FontSize="12"/></Border></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,8"><Button x:Name="PrepareInsertionTest" Content="Test shortcut" Click="PrepareTest_Click" AutomationProperties.Name="Prepare insertion test" HorizontalAlignment="Left"/><TextBlock x:Name="ShortcutStatus" Text="Ctrl + Win: checking listener" Style="{StaticResource Description}" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,0,0,14"><CheckBox x:Name="LiveTranscription" Content="Show live transcription" FontWeight="SemiBold"/><TextBlock Text="Local snapshots appear while you speak. Provisional words can change; final cleanup runs after stopping. Editing in Sona protects your words and keeps the draft here." Style="{StaticResource Description}"/></StackPanel></Border>
<Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,0,0,14"><CheckBox x:Name="PasteCompletedDraft" Content="Paste the complete draft at once" FontWeight="SemiBold"/><TextBlock Text="Waits for recognition and cleanup, then pastes once. Temporarily uses the clipboard and restores it unless you copy something else. Turn off to type single-line text instead." Style="{StaticResource Description}"/></StackPanel></Border>
<Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,0,0,14"><CheckBox x:Name="EnterToSend" Content="Enter finishes and sends hands-free dictation" FontWeight="SemiBold"/><TextBlock Text="After double-tap, press Enter to finish. Sona pastes the full draft, verifies it in the original composer, then presses Enter once. Shift+Enter stays a newline. If focus or verification changes, it does not send." Style="{StaticResource Description}"/></StackPanel></Border>
<Border Style="{StaticResource SettingRow}"><CheckBox x:Name="AutoInsert" Content="Insert into the original field when it is still focused" FontWeight="SemiBold"/></Border>
<Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CopyToClipboard" Content="Also copy completed dictation to the clipboard" FontWeight="SemiBold" AutomationProperties.Name="Copy completed dictation to clipboard"/></Border>
</StackPanel></Border></StackPanel>
<StackPanel x:Name="SettingsAppearanceSection" Visibility="Collapsed"><Border Style="{StaticResource SettingGroup}"><StackPanel>
<Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,14"><TextBlock Text="Recording display" FontWeight="SemiBold"/><TextBlock Text="A detailed panel or a compact capsule. Both follow your microphone level." Style="{StaticResource Description}" Margin="0,5,0,12"/><WrapPanel><RadioButton x:Name="PanelDisplay" Content="Panel" GroupName="RecordingDisplay" Tag="Panel" Checked="DisplayChanged" AutomationProperties.AutomationId="PanelDisplay" Margin="0,0,24,0"/><RadioButton x:Name="CapsuleDisplay" Content="Capsule" GroupName="RecordingDisplay" Tag="Capsule" Checked="DisplayChanged" AutomationProperties.AutomationId="CapsuleDisplay" Margin="0,0,24,0"/><Button x:Name="PreviewVoiceBar" Content="Preview display" Click="PreviewBar_Click"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="Appearance" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ThemeChoice" AutomationProperties.Name="Theme" Margin="0,7" SelectionChanged="ThemeChanged"><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="5,10,0,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox></Grid></Border>
</StackPanel></Border></StackPanel>
<StackPanel x:Name="SettingsCleanupSection" Visibility="Collapsed"><TextBlock Text="TEXT CLEANUP" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CleanupEnabled" Content="Polish dictated text with a local model" FontWeight="SemiBold" AutomationProperties.Name="Enable local text cleanup"/></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Formatting" VerticalAlignment="Center"/><ComboBox x:Name="CleanupToneChoice" Style="{StaticResource SettingChoice}" AutomationProperties.Name="Cleanup formatting"><ComboBoxItem Content="Polished" Tag="formal"/><ComboBoxItem Content="Casual" Tag="casual"/><ComboBoxItem Content="Lowercase" Tag="very casual"/></ComboBox></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Processing" VerticalAlignment="Center"/><ComboBox x:Name="CleanupEngineChoice" Style="{StaticResource SettingChoice}" AutomationProperties.Name="Cleanup processing" ToolTip="GPU uses NVIDIA CUDA when its runtime is installed. CPU uses system RAM."><ComboBoxItem Content="GPU / VRAM" Tag="Auto"/><ComboBoxItem Content="CPU / RAM" Tag="Cpu"/></ComboBox></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><TextBlock Text="Unload after inactivity" VerticalAlignment="Center"/><ComboBox x:Name="CleanupIdleChoice" Style="{StaticResource SettingChoice}" AutomationProperties.Name="Cleanup memory idle timeout"><ComboBoxItem Content="1 minute" Tag="1"/><ComboBoxItem Content="5 minutes" Tag="5"/><ComboBoxItem Content="10 minutes" Tag="10"/><ComboBoxItem Content="30 minutes" Tag="30"/><ComboBoxItem Content="Keep until quit" Tag="0"/></ComboBox></Grid></Border>
     <StackPanel Margin="16,12"><TextBlock Text="Speech cleanup model" FontWeight="SemiBold"/><TextBlock Text="Spokenly Cleanup 1 · 610 MiB · third-party open weights, runs on this device" Style="{StaticResource Description}"/><TextBlock Text="Fixes punctuation, repeated words and spoken corrections. Your original transcript stays available. Verbatim skips cleanup." Style="{StaticResource Description}" Margin="0,6,0,0"/><TextBlock x:Name="CleanupMemory" Text="Not loaded" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/><WrapPanel Margin="0,10,0,0"><Button x:Name="InstallCleanupButton" Content="Set up selected backend" Click="InstallCleanup_Click" Margin="0,0,8,5"/><Button x:Name="LoadCleanupButton" Content="Load cleanup model" Click="LoadCleanup_Click" Margin="0,0,8,5"/><Button x:Name="UnloadCleanupButton" Content="Unload cleanup model" Click="UnloadCleanup_Click" Margin="0,0,8,5"/><Button x:Name="CancelCleanupSetupButton" Content="Cancel setup" Click="CancelCleanupSetup_Click" Margin="0,0,0,5"/></WrapPanel><TextBlock x:Name="CleanupResult" Text="Save preferences to apply these choices." TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    </StackPanel></Border></StackPanel>
<StackPanel x:Name="SettingsPrivacySection" Visibility="Collapsed"><TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Local-only transcription" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="On" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><CheckBox x:Name="KeepHistory" Content="Keep text history on this device" FontWeight="SemiBold"/></Border>
    </StackPanel></Border>
    <TextBlock Text="History stays in this session unless you enable saving. Recordings are deleted after transcription." Style="{StaticResource Description}" Margin="14,10,0,0"/>
    </StackPanel>
<StackPanel x:Name="SettingsDiscordSection" Visibility="Collapsed"><Border Style="{StaticResource SettingGroup}" Padding="18"><StackPanel>
     <Border x:Name="DiscordConnectionBadge" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="HushStatus" Text="Not connected" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="DiscordConnectionDetail" Text="Connect Discord to use call protection." TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
     <WrapPanel Margin="0,0,0,18"><Button x:Name="ConnectDiscordButton" Content="Connect Discord" Click="ConnectDiscord_Click"/><Button x:Name="DisconnectDiscordButton" Content="Disconnect" Click="DisconnectDiscord_Click" Margin="10,0,0,0" Visibility="Collapsed"/></WrapPanel>
     <CheckBox x:Name="ProtectionEnabled" Content="Mute Discord while dictating"/>
     <CheckBox x:Name="SilenceIncoming" Content="Also silence incoming Discord audio" Margin="0,12,0,0"/>
     <TextBlock Text="Watched apps (one executable or package ID per line)" Style="{StaticResource Description}" Margin="0,12,0,6"/><TextBox x:Name="WatchedApps" AcceptsReturn="True" MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Watched recording apps"/>
     <TextBlock Text="Release delay, in milliseconds (0 to 5000)" Style="{StaticResource Description}" Margin="0,12,0,6"/><TextBox x:Name="ProtectionDelay" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Protection release delay"/>
     <TextBlock Text="Pause shortcut (for example ctrl+shift+h)" Style="{StaticResource Description}" Margin="0,12,0,6"/><TextBox x:Name="ProtectionShortcutInput" AutomationProperties.Name="Protection pause shortcut"/>
     <WrapPanel Margin="0,14,0,0"><Button Content="Save protection" Click="SaveProtection_Click"/><Button x:Name="PauseProtectionButton" Content="Pause protection" Click="PauseProtection_Click" Margin="10,0,0,0"/></WrapPanel>

     <TextBlock x:Name="ProtectionResult" Style="{StaticResource Description}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     <Expander Header="Migrate from Hush" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="Import your existing local Hush credentials and settings only when requested. Review settings and save protection separately; pause and quit Hush before connecting." Style="{StaticResource Description}"/><Button Content="Import Hush setup" Click="ImportHush_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander><Expander Header="Set up your own Discord application" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Use your own Discord application ID and secret, or import your existing Hush setup. Approve the connection in Discord when asked. No separate bot is needed." Style="{StaticResource Description}"/><TextBox x:Name="DiscordClientId" AutomationProperties.Name="Discord application ID" Margin="0,10,0,0"/><PasswordBox x:Name="DiscordClientSecret" AutomationProperties.Name="Discord application secret" Margin="0,10,0,0" Background="{DynamicResource Inset}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" Padding="8"/><Button x:Name="SaveDiscordSetupButton" Content="Save protected setup" Click="SaveDiscordSetup_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
     <TextBlock Text="External apps are detected from Windows microphone activity, with a polling delay of up to about 500 ms. Sona waits for protection before opening its own microphone. Existing manual mute is preserved. The pause shortcut is reserved only while protection is enabled." Style="{StaticResource Description}" Margin="0,10,0,0"/>
    </StackPanel></Border></StackPanel>
<StackPanel x:Name="SettingsAboutSection" Visibility="Collapsed"><TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel><Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CheckUpdates" Content="Check GitHub for updates at startup and every 12 hours" FontWeight="SemiBold"/></Border><StackPanel Margin="16,12"><TextBlock x:Name="UpdateStatus" Text="GitHub release checks need no Sona account. No automatic installation." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Check for updates" Click="UpdateCheck_Click"/><Button x:Name="UpdateRelease" Content="View update" Click="UpdateRelease_Click" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel></StackPanel></StackPanel></Border>
    <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel Margin="16,9"><Grid><local:VersionLabel Text="{x:Static local:AppVersion.Display}" AutomationProperties.AutomationId="AboutVersion" VerticalAlignment="Center"/><Button Content="Quit Sona" Click="Quit_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="ProfileIdentity" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
     <TextBlock x:Name="SettingsResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
   </Grid>
  </TabItem>
  <TabItem Header="Modes" Tag="&#xE734;" AutomationProperties.AutomationId="ModesTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Modes" Style="{StaticResource PageTitle}"/><TextBlock Text="Choose how your transcript becomes a draft." Style="{StaticResource Description}"/>
   <Border Style="{StaticResource SettingGroup}" Margin="0,22,0,0" Padding="18"><StackPanel><Grid><TextBlock Text="Default mode" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Ctrl + Win" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid><ComboBox x:Name="DraftStyle" AutomationProperties.Name="Draft style" Margin="0,18,0,10"><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Verbatim"/><ComboBoxItem Content="Notes"/></ComboBox><TextBlock Text="Clean removes explicit fillers and applies your vocabulary. Verbatim keeps recognized words. Notes supports spoken paragraph commands." Style="{StaticResource Description}"/><TextBlock x:Name="ModeResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Dictation Models" Tag="&#xE720;" AutomationProperties.AutomationId="ModelsTab"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="32,26,32,14"><TextBlock Text="Dictation Models" Style="{StaticResource PageTitle}"/><TextBlock Text="Choose the model for your next dictation. Keep it ready in memory for faster results." Style="{StaticResource Description}"/><TextBlock x:Name="SelectedModelSummary" Style="{StaticResource Description}" Margin="0,8,0,0"/><WrapPanel x:Name="ModelFamilies" Margin="0,14,0,0"/></StackPanel><ScrollViewer x:Name="ModelsScroll" Grid.Row="1" Margin="0,0,0,12" Padding="32,0,32,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <WrapPanel x:Name="ModelCards" HorizontalAlignment="Left"/>
   <TextBlock Text="MEMORY" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}" Padding="16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="Unload after inactivity" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ModelIdleChoice" AutomationProperties.Name="Model idle timeout"><ComboBoxItem Content="1 minute" Tag="1"/><ComboBoxItem Content="5 minutes" Tag="5"/><ComboBoxItem Content="10 minutes" Tag="10"/><ComboBoxItem Content="30 minutes" Tag="30"/><ComboBoxItem Content="Keep until quit" Tag="0"/></ComboBox></Grid><TextBlock x:Name="ResidentStatus" Style="{StaticResource Description}" AutomationProperties.AutomationId="ResidentStatus" Margin="0,10,0,0"/><WrapPanel Margin="0,12,0,0"><Button x:Name="UnloadModelButton" Content="Unload now" Click="UnloadModel_Click" AutomationProperties.AutomationId="UnloadModel" Margin="0,0,10,0"/><Button x:Name="LoadModelButton" Content="Load selected" Click="LoadModel_Click" AutomationProperties.AutomationId="LoadModel" Margin="0,0,10,0"/></WrapPanel></StackPanel></Border>
   <TextBlock Text="Licenses and supported languages appear in each model's details. Download size is different from memory use. Model downloads contact Hugging Face when requested; Parakeet engine setup also contacts GitHub." Style="{StaticResource Description}" Margin="0,12,0,0"/>
   <TextBlock Text="Measurements use small FLEURS samples on this development PC. Lower WER means fewer word differences. Warm timings cover speech recognition, before optional cleanup and insertion. Your voice and hardware can give different results." Style="{StaticResource Description}" Margin="0,12,0,0"/>
   <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><TextBlock x:Name="ModelStatus" Style="{StaticResource Description}" Margin="0,0,16,0" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="TranscriptionEngine" AutomationProperties.Name="Transcription engine"><ComboBoxItem Content="GPU when installed, otherwise CPU"/><ComboBoxItem Content="CPU only"/></ComboBox></Grid><Button x:Name="CancelModelDownloadButton" Content="Cancel download" Click="CancelDownload_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock x:Name="ModelResult" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel></ScrollViewer></Grid></TabItem>
  <TabItem Header="Transcribe File" Tag="&#xE8B7;" AutomationProperties.AutomationId="FileTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Transcribe File" Style="{StaticResource PageTitle}"/><TextBlock Text="Turn a short audio file into an editable local draft." Style="{StaticResource Description}"/><Border Style="{StaticResource SettingGroup}" Padding="22" Margin="0,22,0,0"><StackPanel><TextBlock Text="Choose a WAV file" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="16 kHz mono PCM, up to 2 minutes. Uses your selected local model." Style="{StaticResource Description}"/><Button Content="Choose file" Click="ChooseFile_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="FileResult" Style="{StaticResource Description}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="History" Tag="&#xE81C;" AutomationProperties.Name="History" AutomationProperties.AutomationId="HistoryTab">
   <Grid Margin="32,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="History" Style="{StaticResource PageTitle}"/><TextBlock x:Name="HistoryLabel" Text="Your dictations from this session." Style="{StaticResource Description}"/><TextBlock Text="Open a row to review the complete draft. Ranges use your local calendar." Style="{StaticResource Description}" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,16,0,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid><TextBox x:Name="HistorySearch" TextChanged="HistorySearch_Changed" AutomationProperties.Name="Search transcriptions" Padding="12,10"/><TextBlock Text="Search transcriptions..." Margin="13,10" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="Clear recent..." Click="ClearHistory_Click" Margin="10,0,0,0" AutomationProperties.Name="Preview clearing filtered recent history"/>
     </Grid>
     <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
      <TextBlock Text="Recent" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="HistoryRange" Width="144" SelectedIndex="3" SelectionChanged="HistoryRange_Changed" AutomationProperties.Name="Recent history calendar range"><ComboBoxItem Content="Today" Tag="Today"/><ComboBoxItem Content="Last 7 days" Tag="Last7Days"/><ComboBoxItem Content="Last 30 days" Tag="Last30Days"/><ComboBoxItem Content="All recent" Tag="All"/><ComboBoxItem Content="Specific day" Tag="SpecificDay"/></ComboBox>
      <DatePicker x:Name="HistoryDay" Width="146" MinHeight="36" Margin="10,0,0,0" Visibility="Collapsed" SelectedDateChanged="HistoryDay_Changed" Background="{DynamicResource Inset}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="Specific local history day"><DatePicker.Resources><Style TargetType="{x:Type DatePickerTextBox}" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="8,7"/><Setter Property="BorderThickness" Value="0"/></Style></DatePicker.Resources></DatePicker>
     </WrapPanel>
     <TextBlock x:Name="HistoryCountPreview" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     <Border x:Name="HistoryClearConfirmation" Style="{StaticResource SettingGroup}" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
      <StackPanel><TextBlock x:Name="HistoryClearPreview" TextWrapping="Wrap" FontSize="12"/><WrapPanel Margin="0,10,0,0"><Button x:Name="ConfirmHistoryClear" Content="Clear recent records" Click="ConfirmHistoryClear_Click" Margin="0,0,8,0" AutomationProperties.Name="Confirm clearing the previewed recent records"/><Button Content="Cancel" Click="CancelHistoryClear_Click" AutomationProperties.Name="Cancel clearing history"/></WrapPanel></StackPanel>
     </Border>
    </StackPanel>
    <Grid Grid.Row="2">
     <ListBox x:Name="History" IsSynchronizedWithCurrentItem="False" SelectionChanged="History_Changed" AutomationProperties.Name="Past transcriptions grouped by local day" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
      <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Muted}" Margin="4,12,0,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding SavedLabel}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/><TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Preview}" Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="58"/></StackPanel><StackPanel Grid.Column="1"><Button Content="Open draft" Tag="{Binding}" Click="OpenHistoryDraft_Click" VerticalAlignment="Top" AutomationProperties.Name="Open complete history draft" ToolTip="Open the full draft and original transcript in Home. Nothing is inserted automatically."/><Button Content="Remove saved draft" Tag="{Binding}" Click="DeleteSavedDraft_Click" Margin="0,8,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Saved}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="HistoryEmpty" Text="No history yet. Your dictations will appear here." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,45,0,0" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="HistoryResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
  </TabItem>

  <TabItem Header="Vocabulary" Tag="&#xE8D2;" AutomationProperties.Name="Vocabulary" AutomationProperties.AutomationId="VocabularyTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Vocabulary" Style="{StaticResource PageTitle}"/><TextBlock Text="Names, technical terms, and spellings you want to get right." Style="{StaticResource Description}"/>
    <Grid Margin="0,22,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Word or phrase" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="WordInput" AutomationProperties.Name="Exact vocabulary word"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Heard as (optional)" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="HeardInput" AutomationProperties.Name="Optional spoken correction"/></StackPanel><Button Grid.Column="2" Content="Add word" Click="AddWord_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/></Grid>
    <TextBlock x:Name="VocabularyResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,7,0,14" AutomationProperties.LiveSetting="Polite"/>
    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="WORD" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="HEARD AS" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid>
    <ItemsControl x:Name="WordList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Word}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding HeardAs}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="&#x00D7;" FontSize="18" Padding="8,1" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="RemoveWord_Click" AutomationProperties.Name="{Binding RemoveLabel}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Bulk import" Margin="0,22,0,0"><StackPanel><TextBlock Text="One exact term per line. For a correction: spoken phrase = exact spelling." Style="{StaticResource Description}" Margin="0,10,0,10"/><TextBox x:Name="Vocabulary" AcceptsReturn="True" MinHeight="140" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Vocabulary terms and replacements"/><Button Content="Save vocabulary" Click="Vocabulary_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Snippets" Tag="&#xE8A5;" AutomationProperties.Name="Snippets" AutomationProperties.AutomationId="SnippetsTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Snippets" Style="{StaticResource PageTitle}"/><TextBlock Text="Say a short phrase to insert text you use often." Style="{StaticResource Description}"/>
    <TextBlock Text="Trigger phrase" FontSize="12" Margin="0,22,0,7"/><TextBox x:Name="SnippetTrigger" AutomationProperties.Name="Snippet trigger phrase"/><TextBlock Text="Expanded text" FontSize="12" Margin="0,14,0,7"/><TextBox x:Name="SnippetExpansion" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet expanded text"/>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="AddSnippetButton" Content="Add snippet" Click="AddSnippet_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelSnippetEdit" Content="Cancel edit" Click="CancelSnippetEdit_Click" Visibility="Collapsed" Style="{StaticResource QuietButton}" Margin="7,0,0,0"/></StackPanel><TextBlock x:Name="SnippetResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,15" AutomationProperties.LiveSetting="Polite"/>
    <ItemsControl x:Name="SnippetList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Trigger}" FontWeight="SemiBold"/><TextBlock Text="{Binding Expansion}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Edit" Tag="{Binding}" Click="EditSnippet_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding EditLabel}"/><Button Content="&#x00D7;" FontSize="18" Padding="8,1" Tag="{Binding}" Click="RemoveSnippet_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding RemoveLabel}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Bulk import" Margin="0,22,0,0"><StackPanel><TextBlock Text="One snippet per line: trigger = expansion. Use \n for line breaks." Style="{StaticResource Description}" Margin="0,10,0,10"/><TextBox x:Name="Snippets" AcceptsReturn="True" MinHeight="140" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet triggers and expansions"/><Button Content="Save snippets" Click="Snippets_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
 </TabControl>
 <Border x:Name="PreferencesSaveBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource MaterialEdge}" BorderThickness="0,1,0,0" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Unsaved preferences" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/><Button x:Name="SavePreferencesButton" Grid.Column="1" Content="Save preferences" Click="Preferences_Click" Style="{StaticResource PrimaryButton}"/></Grid></Border>
 </Grid>
</Window>
