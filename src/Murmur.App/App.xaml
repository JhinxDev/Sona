<Application x:Class="Murmur.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#100F19"/><SolidColorBrush x:Key="Panel" Color="#1B1928"/><SolidColorBrush x:Key="Accent" Color="#B697F6"/><SolidColorBrush x:Key="Ink" Color="#F2EDF9"/><SolidColorBrush x:Key="Muted" Color="#B6ADC9"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Canvas}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#302942"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#534667"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#CAB0FB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="White"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#15131F"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#554767"/><Setter Property="Padding" Value="12"/><Setter Property="SelectionBrush" Value="#665082"/><Setter Property="Margin" Value="0,8,0,12"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,12,0,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,8,0,16"/><Setter Property="MinWidth" Value="180"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="17,11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabShell" Padding="{TemplateBinding Padding}" Margin="0,0,6,0" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabShell" Property="Background" Value="#302440"/><Setter TargetName="TabShell" Property="BorderBrush" Value="#655078"/><Setter Property="Foreground" Value="#F2EDF9"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabShell" Property="Background" Value="#252033"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabShell" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabControl"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,7,0,0"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Style.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4B405F" CornerRadius="4" Margin="3,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
  </Application.Resources>
</Application>
