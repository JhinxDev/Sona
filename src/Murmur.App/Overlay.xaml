<Window x:Class="Murmur.App.Overlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Sona voice bar" Width="310" Height="60" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
 <Border CornerRadius="15" BorderBrush="#444447" BorderThickness="1" Background="#F918181C" Padding="12,9" Margin="3"><Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.2"/></Border.Effect>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="59"/><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
   <Viewbox Width="18" Height="22" HorizontalAlignment="Left"><Path x:Name="Mic" Data="M9,4 C9,2 15,2 15,4 L15,11 C15,15 9,15 9,11 Z M6,10 L6,11 C6,19 18,19 18,11 L18,10 M12,18 L12,22 M8,22 L16,22" Stroke="#53CEFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
   <StackPanel x:Name="Wave" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False"><Rectangle Width="3" Height="6" Fill="#53CEFF" RadiusX="1.5" RadiusY="1.5" Margin="2"/><Rectangle Width="3" Height="6" Fill="#53CEFF" RadiusX="1.5" RadiusY="1.5" Margin="2"/><Rectangle Width="3" Height="6" Fill="#53CEFF" RadiusX="1.5" RadiusY="1.5" Margin="2"/><Rectangle Width="3" Height="6" Fill="#53CEFF" RadiusX="1.5" RadiusY="1.5" Margin="2"/><Rectangle Width="3" Height="6" Fill="#53CEFF" RadiusX="1.5" RadiusY="1.5" Margin="2"/></StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="Label" Text="Listening" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="Time" Text="0:00" FontSize="10" Foreground="#AEADB7"/></StackPanel>
   <Button x:Name="StopControl" Grid.Column="3" Click="Stop_Click" ContentTemplate="{x:Null}" Padding="5" Background="Transparent" BorderBrush="Transparent" Focusable="False" IsTabStop="False" AutomationProperties.Name="Stop recording"><Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#E3DEE9"/></Button>
   <Button Grid.Column="4" Click="Cancel_Click" ContentTemplate="{x:Null}" Padding="5" Background="Transparent" BorderBrush="Transparent" Focusable="False" IsTabStop="False" AutomationProperties.Name="Cancel dictation"><Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#B5B2BD" StrokeThickness="1.3" Width="8" Height="8"/></Button>
  </Grid>
 </Border>
</Window>
