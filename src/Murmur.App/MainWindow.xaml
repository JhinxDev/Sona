<Window x:Class="Murmur.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Murmur.App" Style="{StaticResource {x:Type Window}}" Title="Sona" Icon="/Sona;component/Assets/Murmur.ico" Width="1000" Height="700" MinWidth="740" MinHeight="530" WindowStartupLocation="CenterScreen" ShowActivated="False">
 <TabControl x:Name="Pages" AutomationProperties.Name="Sona pages">
  <TabItem Header="Home" Tag="&#xE80F;" AutomationProperties.Name="Home" AutomationProperties.AutomationId="DictationTab">
   <ScrollViewer x:Name="HomeScroll" Padding="32,26" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="{Binding ViewportHeight, ElementName=HomeScroll}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Button x:Name="UpdateNotice" Content="A Sona update is available. View details" Click="UpdateNotice_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Home" Style="{StaticResource PageTitle}"/><TextBlock Text="Dictate into the app you're using, or review your text here." Style="{StaticResource Description}"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SettingGroup}" Padding="18" Margin="0,22,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="Status" Text="Ready to dictate" FontWeight="SemiBold" FontSize="15" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusDetail" Text="Hold Ctrl + Windows while you speak. Release to finish." Style="{StaticResource Description}"/></StackPanel><Button x:Name="RecordButton" Grid.Column="1" Content="Record" Click="Record_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="86" AutomationProperties.Name="Start or stop intentional recording"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><TextBlock Text="Latest draft" FontWeight="SemiBold"/><TextBlock Text="Editable" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Muted}"/></Grid>
     <Grid Grid.Row="1" MinHeight="150"><TextBox x:Name="Draft" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="14" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" TextChanged="Draft_Changed" AutomationProperties.Name="Editable cleaned draft"/><TextBlock Text="Your dictation will appear here." Foreground="{DynamicResource Muted}" Margin="15" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="CopyButton" Content="Copy draft" IsEnabled="False" Click="Copy_Click"/><Button Content="Use original" Click="Original_Click" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/><Button Content="Clear draft" Click="Clear_Click" Style="{StaticResource QuietButton}"/></StackPanel>
     <Expander Grid.Row="3" Header="Original transcript" Margin="0,15,0,0"><TextBox x:Name="Original" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="105" MinHeight="50" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="Original transcript"/></Expander>
    </Grid><TextBlock Grid.Row="3" Text="Esc cancels. Inserted text stays as an unsent draft." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,16,0,12"/>
   </Grid></ScrollViewer>
  </TabItem>
  <TabItem Header="Settings" Tag="&#xE713;" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="INTERFACE" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><StackPanel Margin="0,14"><TextBlock Text="Recording display" FontWeight="SemiBold"/><TextBlock Text="A detailed panel or a compact capsule. Both follow your microphone level." Style="{StaticResource Description}" Margin="0,5,0,12"/><WrapPanel><RadioButton x:Name="PanelDisplay" Content="Panel" GroupName="RecordingDisplay" Tag="Panel" Checked="DisplayChanged" AutomationProperties.AutomationId="PanelDisplay" Margin="0,0,24,0"/><RadioButton x:Name="CapsuleDisplay" Content="Capsule" GroupName="RecordingDisplay" Tag="Capsule" Checked="DisplayChanged" AutomationProperties.AutomationId="CapsuleDisplay" Margin="0,0,24,0"/><Button x:Name="PreviewVoiceBar" Content="Preview display" Click="PreviewBar_Click"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="Appearance" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ThemeChoice" AutomationProperties.Name="Theme" Margin="0,7" SelectionChanged="ThemeChanged"><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="5,10,0,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="&#xE774;" Style="{StaticResource SettingIcon}"/><TextBlock Grid.Column="1" Text="Speech language" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="SpeechLanguage" AutomationProperties.Name="Speech language" Margin="0,7"><ComboBoxItem Content="English + French (auto)" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Fran&#xE7;ais" Tag="fr"/></ComboBox></Grid></Border>
    </StackPanel></Border>
    <TextBlock Text="AUDIO" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="&#xE720;" Style="{StaticResource SettingIcon}"/><TextBlock Grid.Column="1" Text="Microphone" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="Device" AutomationProperties.Name="Microphone" Margin="0,7"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74F;" Style="{StaticResource SettingIcon}"/><TextBlock Text="Sound effects" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Off" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Grid></Border>
    </StackPanel></Border>
    <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE765;" Style="{StaticResource SettingIcon}"/><TextBlock Grid.Column="1" Text="Recording shortcut" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="ShortcutMode" AutomationProperties.Name="Recording shortcut mode" Margin="0,7,12,7"><ComboBoxItem Content="Hold / double-tap"/><ComboBoxItem Content="Toggle"/></ComboBox><Border Grid.Column="3" Background="{DynamicResource Canvas}" CornerRadius="6" Padding="10,7" VerticalAlignment="Center"><TextBlock Text="Ctrl + Win" FontSize="12"/></Border></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="AutoInsert" Content="Insert into the original field when it is still focused" FontWeight="SemiBold"/></Border>
     <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CopyToClipboard" Content="Also copy completed dictation to the clipboard" FontWeight="SemiBold" AutomationProperties.Name="Copy completed dictation to clipboard"/></Border>
     <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CloseToTray" Content="Keep Sona in the tray when I close the window" FontWeight="SemiBold"/></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><CheckBox x:Name="StartWithWindows" Content="Launch at startup" FontWeight="SemiBold"/></Border>
    </StackPanel></Border>
    <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource SettingIcon}"/><TextBlock Text="Local-only transcription" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="On" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><CheckBox x:Name="KeepHistory" Content="Keep text history on this device" FontWeight="SemiBold"/></Border>
    </StackPanel></Border>
    <TextBlock Text="History stays in this session unless you enable saving. Recordings are deleted after transcription." Style="{StaticResource Description}" Margin="14,10,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="Save preferences" Click="Preferences_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="PrepareInsertionTest" Content="Test shortcut" Click="PrepareTest_Click" AutomationProperties.Name="Prepare insertion test" Margin="10,0,0,0"/><Button Content="Refresh microphones" Click="Refresh_Click" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></StackPanel>
    <TextBlock x:Name="SettingsResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ShortcutStatus" Text="Ctrl + Win: checking listener" Style="{StaticResource Description}" Margin="0,10,0,0"/>
    <TextBlock Text="CALL PROTECTION" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}" Padding="18"><StackPanel>
     <CheckBox x:Name="ProtectionEnabled" Content="Mute Discord while dictating"/>
     <CheckBox x:Name="SilenceIncoming" Content="Also silence incoming Discord audio" Margin="0,12,0,0"/>
     <TextBlock Text="Watched apps (one executable or package ID per line)" Style="{StaticResource Description}" Margin="0,12,0,6"/><TextBox x:Name="WatchedApps" AcceptsReturn="True" MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Watched recording apps"/>
     <TextBlock Text="Release delay, in milliseconds (0 to 5000)" Style="{StaticResource Description}" Margin="0,12,0,6"/><TextBox x:Name="ProtectionDelay" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Protection release delay"/>
     <TextBlock Text="Pause shortcut (for example ctrl+shift+h)" Style="{StaticResource Description}" Margin="0,12,0,6"/><TextBox x:Name="ProtectionShortcutInput" AutomationProperties.Name="Protection pause shortcut"/>
     <WrapPanel Margin="0,14,0,0"><Button Content="Save protection" Click="SaveProtection_Click"/><Button Content="Import Hush setup" Click="ImportHush_Click" Margin="10,0,0,0"/><Button Content="Connect Discord" Click="ConnectDiscord_Click" Margin="10,0,0,0"/><Button Content="Pause / resume" Click="PauseProtection_Click" Margin="10,0,0,0"/></WrapPanel>
     <TextBlock x:Name="HushStatus" Text="Off. Local Discord connection; no Sona account required." Style="{StaticResource Description}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="ProtectionResult" Style="{StaticResource Description}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     <Expander Header="Set up your own Discord application" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Discord RPC requires an authorized developer application. Use your own ID and secret, or import your existing Hush setup. Sona does not ship shared credentials." Style="{StaticResource Description}"/><TextBox x:Name="DiscordClientId" AutomationProperties.Name="Discord application ID" Margin="0,10,0,0"/><PasswordBox x:Name="DiscordClientSecret" AutomationProperties.Name="Discord application secret" Margin="0,10,0,0" Background="{DynamicResource Inset}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" Padding="8"/><Button Content="Save protected setup" Click="SaveDiscordSetup_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
     <TextBlock Text="External apps are detected from Windows microphone activity, with a polling delay of up to about 500 ms. Sona waits for protection before opening its own microphone. Existing manual mute is preserved. The pause shortcut is reserved only while protection is enabled." Style="{StaticResource Description}" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel><Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CheckUpdates" Content="Check GitHub for updates at startup and every 12 hours" FontWeight="SemiBold"/></Border><StackPanel Margin="16,12"><TextBlock x:Name="UpdateStatus" Text="GitHub release checks need no Sona account. No automatic installation." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Check for updates" Click="UpdateCheck_Click"/><Button x:Name="UpdateRelease" Content="View update" Click="UpdateRelease_Click" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel></StackPanel></StackPanel></Border>
    <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><Grid Margin="16,9"><local:VersionLabel Text="{x:Static local:AppVersion.Display}" AutomationProperties.AutomationId="AboutVersion" VerticalAlignment="Center"/><Button Content="Quit Sona" Click="Quit_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/></Grid></Border>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Modes" Tag="&#xE734;" AutomationProperties.AutomationId="ModesTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Modes" Style="{StaticResource PageTitle}"/><TextBlock Text="Choose how your transcript becomes a draft." Style="{StaticResource Description}"/>
   <Border Style="{StaticResource SettingGroup}" Margin="0,22,0,0" Padding="18"><StackPanel><Grid><TextBlock Text="Default mode" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Ctrl + Win" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid><ComboBox x:Name="DraftStyle" AutomationProperties.Name="Draft style" Margin="0,18,0,10"><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Verbatim"/><ComboBoxItem Content="Notes"/></ComboBox><TextBlock Text="Clean removes explicit fillers and applies your vocabulary. Verbatim keeps recognized words. Notes supports spoken paragraph commands." Style="{StaticResource Description}"/><Button Content="Save mode" Click="Preferences_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="ModeResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Dictation Models" Tag="&#xE720;" AutomationProperties.AutomationId="ModelsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Dictation Models" Style="{StaticResource PageTitle}"/><TextBlock Text="Choose the model for your next dictation. Keep it ready in memory for faster results." Style="{StaticResource Description}"/>
   <TextBlock Text="LOCAL MODELS" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel x:Name="ModelCards"/></Border>
   <TextBlock Text="MEMORY" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}" Padding="16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="Unload after inactivity" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ModelIdleChoice" AutomationProperties.Name="Model idle timeout"><ComboBoxItem Content="1 minute" Tag="1"/><ComboBoxItem Content="5 minutes" Tag="5"/><ComboBoxItem Content="10 minutes" Tag="10"/><ComboBoxItem Content="30 minutes" Tag="30"/><ComboBoxItem Content="Keep until quit" Tag="0"/></ComboBox></Grid><TextBlock x:Name="ResidentStatus" Style="{StaticResource Description}" AutomationProperties.AutomationId="ResidentStatus" Margin="0,10,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="Unload now" Click="UnloadModel_Click" AutomationProperties.AutomationId="UnloadModel" Margin="0,0,10,0"/><Button Content="Load selected" Click="LoadModel_Click" AutomationProperties.AutomationId="LoadModel" Margin="0,0,10,0"/><Button Content="Save memory preference" Click="Preferences_Click"/></WrapPanel></StackPanel></Border>
   <TextBlock Text="All models are multilingual and MIT licensed. Download sizes are not memory requirements. Downloads contact Hugging Face only when requested." Style="{StaticResource Description}" Margin="0,12,0,0"/>
   <TextBlock Text="Benchmarks: 8 French and 8 English FLEURS clips, Small CPU and Turbo CUDA on this development PC. WER is lower when fewer words differ; seconds are median transcription time. These are a small sample, not personal dictation accuracy or a cross-device speed guarantee." Style="{StaticResource Description}" Margin="0,12,0,0"/>
   <ComboBox x:Name="TranscriptionEngine" AutomationProperties.Name="Transcription engine" Margin="0,20,0,0"><ComboBoxItem Content="GPU when installed, otherwise CPU"/><ComboBoxItem Content="CPU only"/></ComboBox><TextBlock x:Name="ModelStatus" Style="{StaticResource Description}" Margin="0,12,0,0"/><Button Content="Save model preferences" Click="Preferences_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/><Button Content="Cancel download" Click="CancelDownload_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock x:Name="ModelResult" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Transcribe File" Tag="&#xE8B7;" AutomationProperties.AutomationId="FileTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Transcribe File" Style="{StaticResource PageTitle}"/><TextBlock Text="Turn a short audio file into an editable local draft." Style="{StaticResource Description}"/><Border Style="{StaticResource SettingGroup}" Padding="22" Margin="0,22,0,0"><StackPanel><TextBlock Text="Choose a WAV file" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="16 kHz mono PCM, up to 2 minutes. Uses your selected local model." Style="{StaticResource Description}"/><Button Content="Choose file" Click="ChooseFile_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="FileResult" Style="{StaticResource Description}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="History" Tag="&#xE81C;" AutomationProperties.Name="History" AutomationProperties.AutomationId="HistoryTab">
   <Grid Margin="32,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="History" Style="{StaticResource PageTitle}"/><TextBlock x:Name="HistoryLabel" Text="Your dictations from this session." Style="{StaticResource Description}"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,22,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="HistorySearch" TextChanged="HistorySearch_Changed" AutomationProperties.Name="Search transcriptions" Padding="12,10"/><TextBlock Text="Search transcriptions..." Margin="13,10" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" Content="Clear history" Click="ClearHistory_Click" Margin="10,0,0,0"/></Grid>
    <Grid Grid.Row="2"><ListBox x:Name="History" SelectionChanged="History_Changed" AutomationProperties.Name="Past transcriptions" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,13"><StackPanel><TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Preview}" Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="58"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="HistoryEmpty" Text="No history yet. Your dictations will appear here." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,45,0,0" TextAlignment="Center" IsHitTestVisible="False"/></Grid><TextBlock Grid.Row="3" x:Name="HistoryResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
  </TabItem>
  <TabItem Header="Vocabulary" Tag="&#xE8D2;" AutomationProperties.Name="Vocabulary" AutomationProperties.AutomationId="VocabularyTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Vocabulary" Style="{StaticResource PageTitle}"/><TextBlock Text="Names, technical terms, and spellings you want to get right." Style="{StaticResource Description}"/>
    <Grid Margin="0,22,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Word or phrase" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="WordInput" AutomationProperties.Name="Exact vocabulary word"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Heard as (optional)" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="HeardInput" AutomationProperties.Name="Optional spoken correction"/></StackPanel><Button Grid.Column="2" Content="Add word" Click="AddWord_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/></Grid>
    <TextBlock x:Name="VocabularyResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,7,0,14" AutomationProperties.LiveSetting="Polite"/>
    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="WORD" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="HEARD AS" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid>
    <ItemsControl x:Name="WordList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Word}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding HeardAs}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="&#x00D7;" FontSize="18" Padding="8,1" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="RemoveWord_Click" AutomationProperties.Name="{Binding RemoveLabel}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Bulk import" Margin="0,22,0,0"><StackPanel><TextBlock Text="One exact term per line. For a correction: spoken phrase = exact spelling." Style="{StaticResource Description}" Margin="0,10,0,10"/><TextBox x:Name="Vocabulary" AcceptsReturn="True" MinHeight="140" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Vocabulary terms and replacements"/><Button Content="Save vocabulary" Click="Vocabulary_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Snippets" Tag="&#xE8A5;" AutomationProperties.Name="Snippets" AutomationProperties.AutomationId="SnippetsTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Snippets" Style="{StaticResource PageTitle}"/><TextBlock Text="Say a short phrase to insert text you use often." Style="{StaticResource Description}"/>
    <TextBlock Text="Trigger phrase" FontSize="12" Margin="0,22,0,7"/><TextBox x:Name="SnippetTrigger" AutomationProperties.Name="Snippet trigger phrase"/><TextBlock Text="Expanded text" FontSize="12" Margin="0,14,0,7"/><TextBox x:Name="SnippetExpansion" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet expanded text"/>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="AddSnippetButton" Content="Add snippet" Click="AddSnippet_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelSnippetEdit" Content="Cancel edit" Click="CancelSnippetEdit_Click" Visibility="Collapsed" Style="{StaticResource QuietButton}" Margin="7,0,0,0"/></StackPanel><TextBlock x:Name="SnippetResult" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,15" AutomationProperties.LiveSetting="Polite"/>
    <ItemsControl x:Name="SnippetList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Trigger}" FontWeight="SemiBold"/><TextBlock Text="{Binding Expansion}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Edit" Tag="{Binding}" Click="EditSnippet_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding EditLabel}"/><Button Content="&#x00D7;" FontSize="18" Padding="8,1" Tag="{Binding}" Click="RemoveSnippet_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding RemoveLabel}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Bulk import" Margin="0,22,0,0"><StackPanel><TextBlock Text="One snippet per line: trigger = expansion. Use \n for line breaks." Style="{StaticResource Description}" Margin="0,10,0,10"/><TextBox x:Name="Snippets" AcceptsReturn="True" MinHeight="140" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet triggers and expansions"/><Button Content="Save snippets" Click="Snippets_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
 </TabControl>
</Window>
