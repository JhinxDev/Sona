<Window x:Class="Murmur.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Sona" Icon="/Assets/Murmur.ico" Width="1000" Height="700" MinWidth="740" MinHeight="530" WindowStartupLocation="CenterScreen" ShowActivated="False">
 <TabControl x:Name="Pages" AutomationProperties.Name="Sona pages">
  <TabItem Header="Home" Tag="&#xE80F;" AutomationProperties.Name="Home" AutomationProperties.AutomationId="DictationTab">
   <ScrollViewer x:Name="HomeScroll" Padding="32,26" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="{Binding ViewportHeight, ElementName=HomeScroll}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Home" Style="{StaticResource PageTitle}"/><TextBlock Text="Dictate into the app you're using, or review your text here." Style="{StaticResource Description}"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SettingGroup}" Padding="18" Margin="0,22,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="Status" Text="Ready to dictate" FontWeight="SemiBold" FontSize="15" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusDetail" Text="Hold Ctrl + Windows while you speak. Release to finish." Style="{StaticResource Description}"/></StackPanel><Button x:Name="RecordButton" Grid.Column="1" Content="Record" Click="Record_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="86" AutomationProperties.Name="Start or stop intentional recording"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><TextBlock Text="Latest draft" FontWeight="SemiBold"/><TextBlock Text="Editable" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
     <Grid Grid.Row="1" MinHeight="150"><TextBox x:Name="Draft" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" TextChanged="Draft_Changed" AutomationProperties.Name="Editable cleaned draft"/><TextBlock Text="Your dictation will appear here." Foreground="{StaticResource Muted}" Margin="15" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="CopyButton" Content="Copy draft" IsEnabled="False" Click="Copy_Click"/><Button Content="Use original" Click="Original_Click" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/><Button Content="Clear draft" Click="Clear_Click" Style="{StaticResource QuietButton}"/></StackPanel>
     <Expander Grid.Row="3" Header="Original transcript" Margin="0,15,0,0"><TextBox x:Name="Original" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="105" MinHeight="50" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="Original transcript"/></Expander>
    </Grid><TextBlock Grid.Row="3" Text="Esc cancels. Inserted text stays as an unsent draft." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,12"/>
   </Grid></ScrollViewer>
  </TabItem>
  <TabItem Header="Settings" Tag="&#xE713;" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="INTERFACE" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7F4;" Style="{StaticResource SettingIcon}"/><TextBlock Grid.Column="1" Text="Recording display" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="2" x:Name="PreviewVoiceBar" Content="Preview capsule" Click="PreviewBar_Click" Margin="0,9"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource SettingIcon}"/><TextBlock Text="Appearance" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Dark" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="&#xE774;" Style="{StaticResource SettingIcon}"/><TextBlock Grid.Column="1" Text="Speech language" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="SpeechLanguage" AutomationProperties.Name="Speech language" Margin="0,7"><ComboBoxItem Content="English + French (auto)" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Fran&#xE7;ais" Tag="fr"/></ComboBox></Grid></Border>
    </StackPanel></Border>
    <TextBlock Text="AUDIO" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="&#xE720;" Style="{StaticResource SettingIcon}"/><TextBlock Grid.Column="1" Text="Microphone" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="Device" AutomationProperties.Name="Microphone" Margin="0,7"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74F;" Style="{StaticResource SettingIcon}"/><TextBlock Text="Sound effects" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Off" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid></Border>
    </StackPanel></Border>
    <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE765;" Style="{StaticResource SettingIcon}"/><TextBlock Grid.Column="1" Text="Recording shortcut" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="ShortcutMode" AutomationProperties.Name="Recording shortcut mode" Margin="0,7,12,7"><ComboBoxItem Content="Hold"/><ComboBoxItem Content="Toggle"/></ComboBox><Border Grid.Column="3" Background="{StaticResource Canvas}" CornerRadius="6" Padding="10,7" VerticalAlignment="Center"><TextBlock Text="Ctrl + Win" FontSize="12"/></Border></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="AutoInsert" Content="Insert into the original field when it is still focused" FontWeight="SemiBold"/></Border>
     <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="CloseToTray" Content="Keep Sona in the tray when I close the window" FontWeight="SemiBold"/></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><CheckBox x:Name="StartWithWindows" Content="Launch at startup" FontWeight="SemiBold"/></Border>
    </StackPanel></Border>
    <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
     <Border Style="{StaticResource SettingRow}"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource SettingIcon}"/><TextBlock Text="Local-only transcription" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="On" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#53CEFF"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0"><CheckBox x:Name="KeepHistory" Content="Keep text history on this device" FontWeight="SemiBold"/></Border>
    </StackPanel></Border>
    <TextBlock Text="History stays in this session unless you enable saving. Recordings are deleted after transcription." Style="{StaticResource Description}" Margin="14,10,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="Save preferences" Click="Preferences_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="PrepareInsertionTest" Content="Test shortcut" Click="PrepareTest_Click" AutomationProperties.Name="Prepare insertion test" Margin="10,0,0,0"/><Button Content="Refresh microphones" Click="Refresh_Click" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></StackPanel>
    <TextBlock x:Name="SettingsResult" Foreground="#53CEFF" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ShortcutStatus" Text="Ctrl + Win: checking listener" Style="{StaticResource Description}" Margin="0,10,0,0"/>
    <TextBlock x:Name="HushStatus" Text="For call protection, add Sona.exe in Hush's Apps settings." Style="{StaticResource Description}" Margin="0,10,0,0"/>
    <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><Grid Margin="16,9"><TextBlock Text="Sona 0.1.1" VerticalAlignment="Center"/><Button Content="Quit Sona" Click="Quit_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/></Grid></Border>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Modes" Tag="&#xE734;" AutomationProperties.AutomationId="ModesTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Modes" Style="{StaticResource PageTitle}"/><TextBlock Text="Choose how your transcript becomes a draft." Style="{StaticResource Description}"/>
   <Border Style="{StaticResource SettingGroup}" Margin="0,22,0,0" Padding="18"><StackPanel><Grid><TextBlock Text="Default mode" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Ctrl + Win" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/></Grid><ComboBox x:Name="DraftStyle" AutomationProperties.Name="Draft style" Margin="0,18,0,10"><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Verbatim"/><ComboBoxItem Content="Notes"/></ComboBox><TextBlock Text="Clean removes explicit fillers and applies your vocabulary. Verbatim keeps recognized words. Notes supports spoken paragraph commands." Style="{StaticResource Description}"/><Button Content="Save mode" Click="Preferences_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="ModeResult" Foreground="#53CEFF" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Dictation Models" Tag="&#xE720;" AutomationProperties.AutomationId="ModelsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Dictation Models" Style="{StaticResource PageTitle}"/><TextBlock Text="Choose an installed on-device engine. Each model unloads after your draft." Style="{StaticResource Description}"/>
   <TextBlock Text="LOCAL MODELS" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource SettingGroup}"><StackPanel>
    <Border Style="{StaticResource SettingRow}" Padding="18"><StackPanel><TextBlock Text="Whisper Large v3 Turbo" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="GPU acceleration, multilingual, larger model" Style="{StaticResource Description}"/></StackPanel></Border>
    <Border Style="{StaticResource SettingRow}" Padding="18" BorderThickness="0"><StackPanel><TextBlock Text="Whisper Small" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="CPU, multilingual, lower memory use" Style="{StaticResource Description}"/></StackPanel></Border>
   </StackPanel></Border><ComboBox x:Name="TranscriptionEngine" AutomationProperties.Name="Transcription engine" Margin="0,20,0,0"><ComboBoxItem Content="More accurate GPU (when installed)"/><ComboBoxItem Content="Lightweight CPU"/></ComboBox><TextBlock x:Name="ModelStatus" Style="{StaticResource Description}" Margin="0,12,0,0"/><Button Content="Save model" Click="Preferences_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="ModelResult" Foreground="#53CEFF" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Transcribe File" Tag="&#xE8B7;" AutomationProperties.AutomationId="FileTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26"><TextBlock Text="Transcribe File" Style="{StaticResource PageTitle}"/><TextBlock Text="Turn a short audio file into an editable local draft." Style="{StaticResource Description}"/><Border Style="{StaticResource SettingGroup}" Padding="22" Margin="0,22,0,0"><StackPanel><TextBlock Text="Choose a WAV file" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="16 kHz mono PCM, up to 2 minutes. Uses your selected local model." Style="{StaticResource Description}"/><Button Content="Choose file" Click="ChooseFile_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="FileResult" Style="{StaticResource Description}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="History" Tag="&#xE81C;" AutomationProperties.Name="History" AutomationProperties.AutomationId="HistoryTab">
   <Grid Margin="32,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="History" Style="{StaticResource PageTitle}"/><TextBlock x:Name="HistoryLabel" Text="Your dictations from this session." Style="{StaticResource Description}"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,22,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="HistorySearch" TextChanged="HistorySearch_Changed" AutomationProperties.Name="Search transcriptions" Padding="12,10"/><TextBlock Text="Search transcriptions..." Margin="13,10" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" Content="Clear history" Click="ClearHistory_Click" Margin="10,0,0,0"/></Grid>
    <Grid Grid.Row="2"><ListBox x:Name="History" SelectionChanged="History_Changed" AutomationProperties.Name="Past transcriptions" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,13"><StackPanel><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Preview}" Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="58"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="HistoryEmpty" Text="No history yet. Your dictations will appear here." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,45,0,0" TextAlignment="Center" IsHitTestVisible="False"/></Grid><TextBlock Grid.Row="3" x:Name="HistoryResult" Foreground="#53CEFF" FontSize="12" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
  </TabItem>
  <TabItem Header="Vocabulary" Tag="&#xE8D2;" AutomationProperties.Name="Vocabulary" AutomationProperties.AutomationId="VocabularyTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Vocabulary" Style="{StaticResource PageTitle}"/><TextBlock Text="Names, technical terms, and spellings you want to get right." Style="{StaticResource Description}"/>
    <Grid Margin="0,22,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Word or phrase" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="WordInput" AutomationProperties.Name="Exact vocabulary word"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Heard as (optional)" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="HeardInput" AutomationProperties.Name="Optional spoken correction"/></StackPanel><Button Grid.Column="2" Content="Add word" Click="AddWord_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/></Grid>
    <TextBlock x:Name="VocabularyResult" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,7,0,14" AutomationProperties.LiveSetting="Polite"/>
    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="WORD" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="HEARD AS" FontSize="10" Foreground="{StaticResource Muted}"/></Grid>
    <ItemsControl x:Name="WordList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Word}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding HeardAs}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="&#x00D7;" FontSize="18" Padding="8,1" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="RemoveWord_Click" AutomationProperties.Name="{Binding RemoveLabel}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Bulk import" Margin="0,22,0,0"><StackPanel><TextBlock Text="One exact term per line. For a correction: spoken phrase = exact spelling." Style="{StaticResource Description}" Margin="0,10,0,10"/><TextBox x:Name="Vocabulary" AcceptsReturn="True" MinHeight="140" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Vocabulary terms and replacements"/><Button Content="Save vocabulary" Click="Vocabulary_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Snippets" Tag="&#xE8A5;" AutomationProperties.Name="Snippets" AutomationProperties.AutomationId="SnippetsTab">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26"><TextBlock Text="Snippets" Style="{StaticResource PageTitle}"/><TextBlock Text="Say a short phrase to insert text you use often." Style="{StaticResource Description}"/>
    <TextBlock Text="Trigger phrase" FontSize="12" Margin="0,22,0,7"/><TextBox x:Name="SnippetTrigger" AutomationProperties.Name="Snippet trigger phrase"/><TextBlock Text="Expanded text" FontSize="12" Margin="0,14,0,7"/><TextBox x:Name="SnippetExpansion" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet expanded text"/>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="AddSnippetButton" Content="Add snippet" Click="AddSnippet_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelSnippetEdit" Content="Cancel edit" Click="CancelSnippetEdit_Click" Visibility="Collapsed" Style="{StaticResource QuietButton}" Margin="7,0,0,0"/></StackPanel><TextBlock x:Name="SnippetResult" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,10,0,15" AutomationProperties.LiveSetting="Polite"/>
    <ItemsControl x:Name="SnippetList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Trigger}" FontWeight="SemiBold"/><TextBlock Text="{Binding Expansion}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Edit" Tag="{Binding}" Click="EditSnippet_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding EditLabel}"/><Button Content="&#x00D7;" FontSize="18" Padding="8,1" Tag="{Binding}" Click="RemoveSnippet_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding RemoveLabel}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Bulk import" Margin="0,22,0,0"><StackPanel><TextBlock Text="One snippet per line: trigger = expansion. Use \n for line breaks." Style="{StaticResource Description}" Margin="0,10,0,10"/><TextBox x:Name="Snippets" AcceptsReturn="True" MinHeight="140" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet triggers and expansions"/><Button Content="Save snippets" Click="Snippets_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
 </TabControl>
</Window>
