<Window x:Class="Murmur.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Murmur · local dictation" Icon="/Assets/Murmur.ico" Width="990" Height="760" MinWidth="640" MinHeight="530" WindowStartupLocation="CenterScreen" ShowActivated="False">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="6,0,6,25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="murmur" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="A place for your voice to become a draft." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="18" Background="#252B29" Padding="15,8"><TextBlock Text="●  On this device" Foreground="#B8D7C4" FontSize="12"/></Border></Grid>
    <TabControl Grid.Row="1" x:Name="Pages" Background="{StaticResource Canvas}" BorderThickness="0" AutomationProperties.Name="Murmur pages">
      <TabItem Header="Dictate"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,26,18,20">
        <TextBlock Text="Speak freely." FontSize="38" FontWeight="SemiBold"/><TextBlock Text="Keep the thought. Lose the friction." FontSize="18" Foreground="{StaticResource Muted}" Margin="0,5,0,25"/>
        <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Status" Text="Ready when you are" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusDetail" Text="Hold Ctrl + Alt + Space in your Codex draft." Foreground="{StaticResource Muted}" Margin="0,8,16,15"/></StackPanel><Button x:Name="RecordButton" Grid.Column="1" Content="Record" Click="Record_Click" VerticalAlignment="Top" AutomationProperties.Name="Start or stop intentional recording"/></Grid><TextBlock Text="Hold: Ctrl + Alt + Space    Toggle: Ctrl + Alt + Shift + Space    Cancel: Esc" FontSize="12" Foreground="{StaticResource Accent}"/></StackPanel></Border>
        <TextBlock Text="Your latest thought" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,2"/><TextBlock Text="Original stays available in this session. Audio is removed after processing." FontSize="12" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="Draft" MinHeight="116" MaxHeight="210" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Draft_Changed" AutomationProperties.Name="Editable cleaned draft"/>
        <WrapPanel><Button x:Name="CopyButton" Content="Copy draft" Click="Copy_Click" IsEnabled="False"/><Button Content="Use original" Click="Original_Click"/><Button Content="Clear session" Click="Clear_Click"/><Button x:Name="PrepareInsertionTest" Content="Prepare insertion test" Click="PrepareTest_Click"/></WrapPanel>
        <TextBlock Text="Insert a ready draft into your chosen field: Ctrl + Alt + Shift + V" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
        <Expander Header="Original transcript" Foreground="{StaticResource Muted}" Margin="0,18,0,0"><TextBox x:Name="Original" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Original transcript"/></Expander>
        <TextBlock x:Name="HistoryLabel" Text="Session history" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8"/><ListBox x:Name="History" MaxHeight="180" Background="#1B1928" Foreground="{StaticResource Ink}" BorderThickness="0" SelectionChanged="History_Changed" AutomationProperties.Name="Recent session transcripts"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Vocabulary"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,26"><TextBlock Text="Your words, exactly." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Add an exact term, such as PowerShell, on its own line to guide recognition. For a spelling correction, use power shell = PowerShell. Code, paths and URLs stay literal." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,12"/><TextBox x:Name="Vocabulary" AcceptsReturn="True" MinHeight="250" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Vocabulary terms and replacements"/><Button Content="Save vocabulary" Click="Vocabulary_Click" HorizontalAlignment="Left"/><TextBlock x:Name="VocabularyResult" Margin="0,15" Foreground="{StaticResource Accent}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Snippets"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,26"><TextBlock Text="A phrase can do more." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="A snippet expands only when the entire utterance matches its trigger. One per line: trigger = expansion. Use \\n for line breaks." Foreground="{StaticResource Muted}" Margin="0,12,0,12"/><TextBox x:Name="Snippets" AcceptsReturn="True" MinHeight="250" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet triggers and expansions"/><Button Content="Save snippets" Click="Snippets_Click" HorizontalAlignment="Left"/><TextBlock x:Name="SnippetResult" Margin="0,15" Foreground="{StaticResource Accent}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Preferences"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,26"><TextBlock Text="Make it feel like yours." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Speech language"/><ComboBox x:Name="SpeechLanguage" AutomationProperties.Name="Speech language"><ComboBoxItem Content="English + French (automatic)" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Français" Tag="fr"/></ComboBox><TextBlock Text="Draft style"/><ComboBox x:Name="DraftStyle" AutomationProperties.Name="Draft style"><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Verbatim"/><ComboBoxItem Content="Notes"/></ComboBox><TextBlock Text="Microphone"/><ComboBox x:Name="Device" MinWidth="330" AutomationProperties.Name="Microphone"/><CheckBox x:Name="AutoInsert" Content="Type into the original field when focus stays unchanged"/><TextBlock Text="If focus changes, keep the draft here. Insertion preserves the clipboard and never sends Enter. Line breaks require an explicit copy." FontSize="12" Foreground="{StaticResource Muted}"/><CheckBox x:Name="CloseToTray" Content="Keep hotkeys available when the window closes"/><CheckBox x:Name="StartWithWindows" Content="Start silently with Windows (opt in)"/><TextBlock x:Name="HushStatus" Text="Hush protection is configured separately in Hush's Apps page: add Murmur.exe." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,20"/><StackPanel Orientation="Horizontal"><Button Content="Save preferences" Click="Preferences_Click"/><Button Content="Refresh microphones" Click="Refresh_Click"/><Button Content="Quit" Click="Quit_Click"/></StackPanel><TextBlock x:Name="SettingsResult" Foreground="{StaticResource Accent}" Margin="0,15"/><TextBlock Text="Local only. No account, analytics, cloud requests or automatic model downloads. A model runs only during transcription, with a 120 second recording limit." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10"/></StackPanel></ScrollViewer></TabItem>
    </TabControl><TextBlock Grid.Row="2" Text="A draft is yours to review. Murmur never submits it." Foreground="{StaticResource Muted}" FontSize="11" Margin="6,15,0,0"/>
  </Grid>
</Window>
